# MySQL / MariaDB connection (the database behind phpMyAdmin).
#
# Prisma talks to MySQL directly over TCP 3306 — it does NOT go through
# phpMyAdmin. To connect from anywhere other than the hosting box itself, add
# the connecting IP under hPanel > Databases > Remote MySQL first, otherwise
# every query fails with ECONNREFUSED.
#
# Replace USER, PASSWORD, HOST and DATABASE with your own values.
#   - URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
#   - Hostinger prefixes names, so they look like "u856490553_liquorshop"
#   - HOST is "localhost" when the app runs on the hosting account itself;
#     when connecting from your laptop or an external host (Vercel), use the
#     remote address shown on the Remote MySQL page
#   - Do NOT append ?schema=public — MySQL has no schemas, the database is one
#   - Add ?sslaccept=strict if your host requires TLS
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# HMAC secret for signing JWTs (access + refresh).
# REQUIRED in production: sign-in returns 503 until this is set to a unique
# 32+ character value. Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: used by Next.js in production
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
