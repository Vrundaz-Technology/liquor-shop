# MySQL connection (phpMyAdmin / local MySQL or MariaDB)
# Replace USER, PASSWORD, and DATABASE with your MySQL credentials.
# Do not append ?schema=public — that is PostgreSQL-only.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: used by Next.js in production
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
